---
import { getCollection } from "astro:content";

const sushiRolls = await getCollection("sushiRolls");
---

<div id="container">
  <main>
    <h1>Hello, World!</h1>
    <ul>
      {
        sushiRolls.map((sushiRoll) => {
          return <li>{sushiRoll.data.name}</li>;
        })
      }
    </ul>
  </main>
</div>

